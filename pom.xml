    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>tomato</imageName>
                            <agent>
                                <enabled>true</enabled>
                                <!-- 自动将收集到的元数据复制到 src/main/resources/META-INF/native-image -->
                                <!-- 正确的 metadataCopy 配置 -->
                                <metadataCopy>
                                    <!-- 指定元数据合并后输出的目标目录 -->
                                    <outputDirectory>${project.basedir}/src/main/resources/META-INF/native-image</outputDirectory>
                                    <!-- 可选：是否合并已存在的文件，默认为 false -->
                                    <merge>true</merge>
                                </metadataCopy>
                            </agent>
                            <buildArgs>

<!--                                <buildArg>&#45;&#45;static &#45;&#45;libc=musl</buildArg>-->
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg> <!-- 未添加此参数会有警告，提示添加此参数，添加后就不会有警告 -->
                                <buildArg>--no-fallback</buildArg>
                                <!--包含所有字符编码，会增大打包结果的大小，我本地测试会增大十几MB-->
                                <buildArg>-H:+AddAllCharsets</buildArg>
                                <!--<buildArg>-H:Optimize="2"</buildArg> &lt;!&ndash; 用于指定编译优化级别，2是默认  控制代码优化：b - 针对最快构建时间进行优化，s - 针对大小进行优化，0 - 无优化，1 - 基本优化，2 - 高级优化，3 - 所有优化以实现最佳性能。 &ndash;&gt;-->
                                <buildArg>-H:-CheckToolchain</buildArg>
                                <buildArg>--initialize-at-run-time=io.netty.channel.kqueue.Native,io.netty.channel.kqueue.KQueueEventArray</buildArg>
                                <!-- Woodstox (MinIO的XML解析器) 需在运行时初始化，否则native环境下XML解析会抛JsonParseException -->
                                <buildArg>--initialize-at-run-time=com.ctc.wstx.stax.WstxInputFactory,com.ctc.wstx.stax.WstxOutputFactory,com.ctc.wstx.stax.WstxEventFactory,com.ctc.wstx.api.ReaderConfig,com.ctc.wstx.api.WriterConfig</buildArg>

                                <!-- 下面两个参数用于在windows系统上用MSVC编译时，是的编译结果双击时不弹出cmd窗口 -->
                                <!-- -H:NativeLinkerOption=/SUBSYSTEM:WINDOWS 告诉链接器生成「GUI 子系统」EXE，禁用 CMD 窗口-->
                                <!-- -H:NativeLinkerOption=/ENTRY:mainCRTStartup 告诉链接器入口点是 mainCRTStartup（适配 Java 的 main 函数）-->
                                <!-- 如果编译使用MinGW，可以使用-H:CCompilerOption=-mwindows或者-H:NativeLinkerOption=-mwindows，未试过，不清楚效果 -->
                                <!-- 其他操作系统未试过 -->
<!--                                <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:WINDOWS</buildArg>-->
<!--                                <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>-->


<!--                               可以用这个参数看到更多辅助信息 native-image - -expert-options 两个-之间没有空格   -->
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- jpackage 打包 profile：mvn clean package -Pjpackage
             思路：复用 maven-assembly-plugin 产出的 fat jar（classpath 运行方式，与开发期一致），
                  用 JDK 自带的 jpackage 生成自带运行时的安装包或绿色目录。
             平台：Windows 默认 exe 安装向导（需 WiX 3.x，项目内置 packaging/wix314）；
                  Linux 自动覆盖为 rpm（需 rpmbuild，见 README 打包说明）；
                  macOS 可用 -Djpackage.type=app-image 或 dmg。
             说明：1. profile 激活时会自动跳过 test 阶段启动 UI 的 java-agent exec，打包过程无需人工干预。
                  2. 产物在 target/jpackage/：Windows 为 tomato-0.0.1.exe，Linux 为 tomato-0.0.1-1.x86_64.rpm。
                  3. 如需绿色目录：mvn clean package -Pjpackage -Djpackage.type=app-image。
                  4. 平台相关参数（图标 + 安装向导选项）由 jpackage-os-win / jpackage-os-linux 两个
                     按 OS 自动激活的 profile 注入到 jpackage.platform.args，无需手动指定。 -->
        <profile>
            <id>jpackage</id>
            <properties>
                <!-- 打包时跳过 test 阶段的 UI 启动（覆盖全局默认值 false） -->
                <agent.exec.skip>true</agent.exec.skip>
            </properties>
            <build>
                <plugins>
                    <!-- 把 fat jar 复制到 target/jpackage-input，作为 jpackage 的 input 目录，
                         避免 input 直接指向 target 把 classes、modules 等全部拷进应用目录 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>stage-jpackage-input</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}-jar-with-dependencies.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 调用 JDK 自带的 jpackage 完成打包 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <!-- Windows 下把 WiX binaries 注入 PATH（jpackage 通过 PATH 查找 candle/light），
                                         Linux 下 WIX 变量被 jpackage 忽略，PATH 追加无效路径也无害 -->
                                    <environmentVariables>
                                        <WIX>${jpackage.wixdir}</WIX>
                                        <PATH>${jpackage.wixdir}${path.separator}${env.PATH}</PATH>
                                    </environmentVariables>
                                    <!-- 用 commandlineArgs 拼接通用参数 + ${jpackage.platform.args}（平台参数由 os-activated profile 注入），
                                         避免 Linux 上传入 win 系列选项导致 jpackage 报错 -->
                                    <commandlineArgs>--type ${jpackage.type} --name ${project.name} --dest "${project.build.directory}/jpackage" --input "${project.build.directory}/jpackage-input" --main-jar ${project.build.finalName}-jar-with-dependencies.jar --main-class ${mainClass} --app-version ${project.version} --vendor tangluobo --description "Tomato database and server connection tool" ${jpackage.platform.args}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Windows 平台：自动注入 ico 图标 + win 安装向导选项（开始菜单、桌面快捷方式、目录选择、升级 UUID） -->
        <profile>
            <id>jpackage-os-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <jpackage.platform.args>--icon "${project.basedir}/packaging/tomato.ico" --win-menu --win-menu-group Tomato --win-shortcut --win-dir-chooser --win-upgrade-uuid 9EDBE186-C9AB-44DC-BA36-5E69BFD9F4A1</jpackage.platform.args>
            </properties>
        </profile>

        <!-- Linux 平台：自动把打包类型覆盖为 rpm，注入 png 图标 + linux 安装选项（菜单分组、桌面快捷方式）。
             前置条件：已安装 rpm-build（rpmbuild 命令）和 JDK 25（JavaFX 27-ea 的 class 版本需要）。 -->
        <profile>
            <id>jpackage-os-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <properties>
                <jpackage.type>rpm</jpackage.type>
                <jpackage.platform.args>--icon "${project.basedir}/src/main/resources/images/logo.png" --linux-menu-group Utility --linux-shortcut --linux-app-release 1</jpackage.platform.args>
            </properties>
        </profile>
    </profiles>
</project>